{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**",".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:check": {
      "outputs": []  
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "checktypes": {
        "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
